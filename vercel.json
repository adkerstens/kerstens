{
  "headers": [
    {
      "source": "/beatwarrior/:path*",
      "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]
    },
    {
      "source": "/beatwarrior/downloads/Beatwarrior-Setup-1.9.8.exe",
      "headers": [
        {"key": "Content-Type", "value": "application/octet-stream"},
        {"key": "Content-Disposition", "value": "attachment; filename=\"Beatwarrior-Setup-1.9.8.exe\""},
        {"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
